{
  "name": "vote-integrity",
  "version": "1.0.0",
  "private": true,
  "description": "Vote Integrity & Counting service: ballot anonymisation (SR-03), replay protection (SR-07), hash-chained audit log (SR-09), independent counting engines (SR-10)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "npm run build && node --env-file=.env dist/server.js",
    "test": "jest --runInBand",
    "demo": "node --env-file=.env scripts/demo.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "4.22.3",
    "jsonwebtoken": "9.0.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "jest": "29.7.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.15",
    "typescript": "5.6.3"
  }
}
